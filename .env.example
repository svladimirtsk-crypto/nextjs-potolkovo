# ============================================================
# AI Advisor — Amvera LLM Inference
# ============================================================

MOCK_AI=false
AMVERA_API_TOKEN=
AMVERA_BASE_URL=https://kong-proxy.yc.amvera.ru/api/v1
AMVERA_MODEL=gpt-4.1

# ============================================================
# Site
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# T-027: ключ Web3Forms теперь ТОЛЬКО серверный (клиентский NEXT_PUBLIC_* удалён)
WEB3FORMS_ACCESS_KEY=

# ============================================================
# Заявки (/api/lead)
# ============================================================
LEAD_API_ENABLED=1
TELEGRAM_LEADS_ENABLED=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет для POST /api/lead/retry (крон повторной доставки)
CRON_SECRET=
# Опционально: строка подключения к БД (схема — db/schema.sql)
DATABASE_URL=

NEXT_PUBLIC_CALC_QUIZ_V2=1

# Catalog source strategy:
# 0 -> snapshot only (default, stable for prod)
# 1 -> try live feed2 first, fallback to snapshot if invalid
CATALOG_LIVE_FEED2_ENABLED=1

# Strict live debug mode:
# 1 -> if live invalid, do not fallback to snapshot, return error
CATALOG_LIVE_FEED2_STRICT=1
