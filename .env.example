# ============================================================
# ПОТОЛКОВО — пример окружения
#
# Скопируйте в `.env.local` и заполните. Реальных ключей здесь нет и быть
# не должно. Схема и значения по умолчанию — в `lib/env.ts`;
# проверить текущее окружение: `npm run check:env`.
# ============================================================

# ------------------------------------------------------------
# Сайт (публичные, попадают в клиентский бандл)
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Квиз-калькулятор V2. 0 — аварийно отключить (V1 удалён в T-060,
# при 0 калькулятор просто не покажет шаг подбора).
NEXT_PUBLIC_CALC_QUIZ_V2=1

# ------------------------------------------------------------
# Заявки (/api/lead)
# ------------------------------------------------------------
# Главный рубильник приёма заявок. 0 — API отвечает 503.
LEAD_API_ENABLED=1

# Основной канал доставки.
TELEGRAM_LEADS_ENABLED=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Запасной канал: дубль заявки почтой. Ключ ТОЛЬКО серверный
# (клиентский NEXT_PUBLIC_* удалён в T-027).
WEB3FORMS_ACCESS_KEY=

# Bearer-секрет для POST /api/lead/retry (крон повторной доставки).
# Без него эндпоинт отвечает 401.
CRON_SECRET=

# Строка подключения к БД лидов (схема — db/schema.ts, применяется
# `npx drizzle-kit push`). Пример: postgres://user:pass@host/db?sslmode=require
#
# Пусто — лиды хранятся в памяти процесса. На serverless это означает, что при
# каждом холодном старте теряются дедуп, серверный rate-limit, очередь ретраев
# и возможность найти заявку по коду. Для прода задавать обязательно.
DATABASE_URL=

# Отдельная БД для интеграционных тестов (tests/lead-*-pg|db.test.ts).
# Не задана — эти тесты пропускаются.
TEST_DATABASE_URL=

# ------------------------------------------------------------
# Каталог света
# ------------------------------------------------------------
# 1 — сначала пробовать живой фид поставщика, при проблеме взять снапшот.
# 0 — всегда снапшот `data/eks-feed2-snapshot.json`.
CATALOG_LIVE_FEED2_ENABLED=1

# Строгий режим отладки: 1 — при невалидном живом фиде НЕ откатываться на
# снапшот, а вернуть ошибку. В проде держите 0.
CATALOG_LIVE_FEED2_STRICT=0
